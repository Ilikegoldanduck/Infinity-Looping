local numbers = require("Assets.scripts.numbers")

local currencyIncreasors = {"/alpha", "/beta", "/delta", "/zeta"}

local alphaUpgradeTree = {"/alphaupgrade1", "/alphaupgrade2", "/alphaupgrade3"}
local betaUpgradeTree = {"/betaupgrade1", "/betaupgrade2", "/betaupgrade3"}
local charlieUpgradeTree = {"/charlieupgrade1", "/charlieupgrade2", "/charlieupgrade3"}
local deltaUpgradeTree = {"/deltaupgrade1", "/deltaupgrade2", "/deltaupgrade3"}

local upgradeTree = {alphaUpgradeTree, betaUpgradeTree, charlieUpgradeTree, deltaUpgradeTree}

local camVelocity = vmath.vector3()

local prevMouse = {0, 0}

local prevTime = os.time()

function init(self)
	msg.post(".", "acquire_input_focus")
	numbers.loadFile()
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	go.set_position(go.get_position() + camVelocity, ".")
	camVelocity = vmath.vector3()

	if os.time() ~= prevTime then
		for i = 1, os.time() - prevTime, 1 do
			if numbers.getValues(2) > 0 then
				numbers.increaseGamma()
			end
			if numbers.getValues(4) > 0 then
				numbers.increaseEpsilon()
			end
		end
	end
	prevTime = os.time()
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

function on_input(self, action_id, action)
	local width, height = window.get_size()
	local camPos = go.get_position()
	local mouse_pos = vmath.vector3((action.x or prevMouse[1]) - (width / 2) + camPos.x, (action.y or prevMouse[2]) - (height / 2) + camPos.y, 0)

	if action.x then
		prevMouse[1] = action.x
		prevMouse[2] = action.y
	end

	if action.pressed and action_id == hash("touch") then
		for i, v in ipairs(currencyIncreasors) do
			if math.abs(mouse_pos.x - go.get_position(v).x) <= 10 and math.abs(mouse_pos.y - go.get_position(v).y) <= 10 then
				if i == 1 then
					numbers.increaseAlpha()
				elseif i == 2 and numbers.checkBetaIncreaseable() then
					numbers.increaseBeta()
				elseif i == 3 and numbers.getValues(3) >= 100 then
					numbers.increaseDelta()
				elseif i == 4 and numbers.getValues(2) > 1 and numbers.getValues(4) > 1 and numbers.getValues(5) > 1 then
					numbers.increaseZeta()
				end
			end
		end
		for tree, upgradeTreeNode in ipairs(upgradeTree) do
			for i, v in ipairs(upgradeTreeNode) do
				if math.abs(mouse_pos.x - go.get_position(v).x) <= 10 and math.abs(mouse_pos.y - go.get_position(v).y) <= 10 and numbers.upgradeCost(tree, i) then
					numbers.buyUpgrade(tree, i)
				end
			end
		end
		if math.abs(mouse_pos.x - go.get_position("save").x) <= 10 and math.abs(mouse_pos.y - go.get_position("save").y) <= 10 then
			numbers.saveFile()
		end
		if math.abs(mouse_pos.x - go.get_position("reset").x) <= 10 and math.abs(mouse_pos.y - go.get_position("reset").y) <= 10 then
			numbers.resetFile()
		end
	else
		if action_id == hash("up") then
			camVelocity.y = 10
		elseif action_id == hash("left") then
			camVelocity.x = -10
		elseif action_id == hash("down") then
			camVelocity.y = -10
		elseif action_id == hash("right") then
			camVelocity.x = 10
		end
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
