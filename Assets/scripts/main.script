local numbers = require("Assets.scripts.numbers")

local currencyIncreasors = {"/point", "/skill", "/research", "/profit"}

local pointUpgradeTree = {"/pointupgrade1", "/pointupgrade2", "/pointupgrade3"}
local skillUpgradeTree = {"/skillupgrade1", "/skillupgrade2", "/skillupgrade3", "/skillupgrade4"}
local timeUpgradeTree = {"/timeupgrade1", "/timeupgrade2", "/timeupgrade3"}
local researchUpgradeTree = {"/researchupgrade1", "/researchupgrade2", "/researchupgrade3"}
local cashUpgradeTree = {"/cashupgrade1", "/cashupgrade2"}

local upgradeTree = {pointUpgradeTree, skillUpgradeTree, timeUpgradeTree, researchUpgradeTree, {}, {}, cashUpgradeTree}

local camVelocity = vmath.vector3()

local prevMouse = {0, 0}
local prevTime = os.time()

local pointAutoCd = 0

function init(self)
	msg.post(".", "acquire_input_focus")
	prevTime = os.time()
	numbers.loadFile()
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	go.set_position(go.get_position() + camVelocity, ".")
	camVelocity = vmath.vector3()

	if os.time() ~= prevTime then
		for i = 1, os.time() - prevTime, 1 do
			if numbers.getValues(2) > 0 then
				numbers.increaseTime()
			end
			if numbers.getValues(4) > 0 then
				numbers.increaseEnergy()
			end
			if numbers.getValues(6) > 0 then
				numbers.increaseCash()
			end
		end
	end
	prevTime = os.time()

	for i, v in ipairs(numbers.getUpdates()) do
		if v[3] == hash("refresh") then

		else
			sprite.play_flipbook(upgradeTree[v[1]][v[2]] .. "#sprite", v[3])
		end
		if v[3] == hash("complete") then
			go.set(upgradeTree[v[1]][v[2]] .. "#costLabel", "text", "")
		else
			go.set(upgradeTree[v[1]][v[2]] .. "#costLabel", "text", numbers.sendCosts(v[1], v[2]))
		end
		go.set(upgradeTree[v[1]][v[2]] .. "#upgradeLabel", "text", numbers.getUpgrade(v[1], v[2]))
	end
end

