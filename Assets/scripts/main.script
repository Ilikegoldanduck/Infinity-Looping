	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
end

function on_input(self, action_id, action)
	local camPos = go.get_position()
	local mouse_pos = vmath.vector3((action.x or prevMouse[1]) + camPos.x, (action.y or prevMouse[2]) + camPos.y, 0)

	pprint(mouse_pos)

	if action.x then
		prevMouse[1] = action.x
		prevMouse[2] = action.y
	end

	if action.pressed and action_id == hash("touch") then
		for i, v in ipairs(currencyIncreasors) do
			if math.abs(mouse_pos.x - go.get_position(v).x) <= 10 and math.abs(mouse_pos.y - go.get_position(v).y) <= 10 then
				if i == 1 then
					numbers.increasePoints()
				elseif i == 2 and numbers.checkSkillIncreaseable() then
					numbers.increaseSkill()
				elseif i == 3 and numbers.getValues(3) >= 100 then
					numbers.increaseResearch()
				elseif i == 4 and numbers.getValues(2) > 1 and numbers.getValues(4) > 1 and numbers.getValues(5) > 1 then
					numbers.increaseProfits()
				end
			end
		end
		for tree, upgradeTreeNode in ipairs(upgradeTree) do
			for i, v in ipairs(upgradeTreeNode) do
				if math.abs(mouse_pos.x - go.get_position(v).x) <= 10 and math.abs(mouse_pos.y - go.get_position(v).y) <= 10 and numbers.upgradeCost(tree, i) then
					numbers.buyUpgrade(tree, i)
				end
			end
		end
		if math.abs(mouse_pos.x - go.get_position("save").x) <= 10 and math.abs(mouse_pos.y - go.get_position("save").y) <= 10 then
			numbers.saveFile()
		end
		if math.abs(mouse_pos.x - go.get_position("reset").x) <= 10 and math.abs(mouse_pos.y - go.get_position("reset").y) <= 10 then
			numbers.resetFile()
		end
	else
		if action_id == hash("up") then
			camVelocity.y = 10
		elseif action_id == hash("left") then
			camVelocity.x = -10
		elseif action_id == hash("down") then
			camVelocity.y = -10
		elseif action_id == hash("right") then
			camVelocity.x = 10
		end
	end
end

function on_reload(self)
