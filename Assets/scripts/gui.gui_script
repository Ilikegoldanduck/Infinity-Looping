	-- Remove this function if not needed
end

local function convertValue(num)
	num = math.floor(num * 100) / 100
	if num >= 1000 then	
		num = math.floor(num * 100) / 100
		return tostring(math.floor(num / math.pow(10, math.floor(math.log(num, 10))) * 100) / 100) .. "e" .. tostring(math.floor(math.log(num, 10)))
	end
	return tostring(num)
end

function update(self, dt)
	local text = ""
	for i, v in ipairs(pinnedValues) do
		if v then
			text = text .. values[i] .. ": " .. convertValue(numbers.getValues(i)) .. " | " .. convertValue(numbers.getMulti(i)) .. "\n"
		end
	end
	gui.set_text(gui.get_node("pinnedCurrency"), text)
	gui.set_text(gui.get_node("researchCd"), "researchCd: " .. tostring(numbers.getResearchOnCd()))
	gui.set_text(gui.get_node("pointCd"), "pointCd: " .. tostring(numbers.getPointsOnCd()))
end

